@page "/admin/categories"
@attribute [Authorize(Roles = "Admin")]
@inject CategoriesService CategoriesService


<h3>Gestion des catégories</h3>

<button class="btn btn-primary mb-3" @onclick="ShowCreateModal">
    <i class="bi bi-plus-circle"></i> Ajouter une catégorie
</button>

@if (categories == null)
{
    <p>Chargement...</p>
}
else
{
    <!-- Tableau paginé -->
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Nb Produits</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in PagedCategories)
            {
                <tr>
                    <td>@cat.Nom</td>
                    <td>@cat.Description</td>
                    <td>@cat.NombreProduits</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="() => ShowEditModal(cat)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(cat.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="#" @onclick="PrevPage">Précédent</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" href="#" @onclick="() => GoToPage(i)">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="#" @onclick="NextPage">Suivant</a>
            </li>
        </ul>
    </nav>
}

<!-- Modal Création / Edition -->
<div class="modal fade @(showModal ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@modalTitle</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nom</label>
                    <input class="form-control" @bind="modalCategory.Nom" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" @bind="modalCategory.Description"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                <button class="btn btn-primary" @onclick="SaveCategory">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CategorieDTO>? categories;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages => categories != null ? (int)Math.Ceiling(categories.Count / (double)pageSize) : 1;
    private IEnumerable<CategorieDTO> PagedCategories => categories?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<CategorieDTO>();

    // Modal
    private bool showModal = false;
    private string modalTitle = "";
    private CategorieDTO modalCategory = new CategorieDTO();
    private CategorieDTO? editingCategory = null;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoriesService.GetAllAsync();
    }

    private void ShowCreateModal()
    {
        modalCategory = new CategorieDTO();
        editingCategory = null;
        modalTitle = "Nouvelle catégorie";
        showModal = true;
    }

    private void ShowEditModal(CategorieDTO cat)
    {
        modalCategory = new CategorieDTO
        {
            Id = cat.Id,
            Nom = cat.Nom,
            Description = cat.Description,
            NombreProduits = cat.NombreProduits
        };
        editingCategory = cat;
        modalTitle = "Modifier la catégorie";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveCategory()
    {
        if (editingCategory != null)
        {
            // Edition
            await CategoriesService.UpdateAsync(modalCategory.Id, modalCategory);
            editingCategory.Nom = modalCategory.Nom;
            editingCategory.Description = modalCategory.Description;
        }
        else
        {
            // Création
            modalCategory.NombreProduits = 0; // champ calculé initial
            var created = await CategoriesService.CreateAsync(modalCategory);
            categories.Add(created);
        }

        showModal = false;
    }

    private async Task Delete(int id)
    {
        await CategoriesService.DeleteAsync(id);
        categories.RemoveAll(c => c.Id == id);
    }

    private void PrevPage()
    {
        if (currentPage > 1) currentPage--;
    }

    private void NextPage()
    {
        if (currentPage < totalPages) currentPage++;
    }

    private void GoToPage(int page)
    {
        currentPage = page;
    }
}
