@page "/admin"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Administration</PageTitle>

<div class="container mt-5">
    <h1 class="mb-4">🔧 Panel d'Administration</h1>
    <p class="text-muted">Seuls les administrateurs ont accès à cette interface</p>

    <div class="row g-4 mt-3">
        <div class="col-md-4">
            <div class="card text-white bg-primary h-100">
                <div class="card-body">
                    <h5 class="card-title">📂 Catégories</h5>
                    <p class="card-text">Ajouter, modifier ou supprimer des catégories</p>
                    <a class="btn btn-light" href="/admin/categories">Gérer</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success h-100">
                <div class="card-body">
                    <h5 class="card-title">🛍️ Produits</h5>
                    <p class="card-text">Gérer le catalogue des produits</p>
                    <a class="btn btn-light" href="/admin/produits">Gérer</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-info h-100">
                <div class="card-body">
                    <h5 class="card-title">🌿 Familles olfactives</h5>
                    <p class="card-text">Ajouter ou modifier les familles olfactives</p>
                    <a class="btn btn-light" href="/admin/familles-olfactives">Gérer</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-warning h-100">
                <div class="card-body">
                    <h5 class="card-title">🏭 Brands</h5>
                    <p class="card-text">Gérer les Brands et leurs produits</p>
                    <a class="btn btn-light" href="/admin/Brands">Gérer</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-danger h-100">
                <div class="card-body">
                    <h5 class="card-title">📝 Commandes</h5>
                    <p class="card-text">Visualiser toutes les commandes et changer les statuts</p>
                    <a class="btn btn-light" href="/admin/commandes">Gérer</a>
                </div>
            </div>
        </div>
    </div>
</div>
