@page "/"
@attribute [Authorize]
@using System.Globalization
@using GestionParfumerie.Application.DTOs
@inject GestionParfumerie.Client.Services.AdminDashboardService dashboardService
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<PageTitle>Tableau de bord</PageTitle>

<div class="container-fluid px-4 py-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3">Chargement des statistiques...</p>
        </div>
    }
    else if (isClient)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Bienvenu cette page est en maintenance.
        </div>
    }
    else if (stats != null)
    {
        <!-- Cartes de statistiques principales -->
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-start-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs fw-bold text-primary text-uppercase mb-1">
                                    Chiffre d'affaires total
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800">
                                    @stats.ChiffreAffairesTotal.ToString("C", new CultureInfo("fr-FR"))
                                </div>
                                <small class="text-muted">
                                    Ce mois: @stats.ChiffreAffairesMoisCourant.ToString("C", new CultureInfo("fr-FR"))
                                </small>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-currency-euro fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-start-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs fw-bold text-success text-uppercase mb-1">
                                    Total commandes
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800">@stats.NombreTotalCommandes</div>
                                <small class="text-muted">Ce mois: @stats.CommandesMoisCourant</small>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-cart-check fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-start-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs fw-bold text-info text-uppercase mb-1">
                                    Total clients
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800">@stats.NombreTotalClients</div>
                                <small class="text-muted">Nouveaux ce mois: @stats.NouveauxClientsMoisCourant</small>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-people fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-start-warning shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs fw-bold text-warning text-uppercase mb-1">
                                    Produits
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800">@stats.NombreTotalProduits</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-box-seam fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statuts des commandes -->
        <div class="row mb-4">
            <div class="col-md-3 mb-4">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h6 class="text-warning">En cours</h6>
                        <h3 class="fw-bold">@stats.CommandesEnCours</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h6 class="text-info">Expédiées</h6>
                        <h3 class="fw-bold">@stats.CommandesExpediees</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h6 class="text-success">Livrées</h6>
                        <h3 class="fw-bold">@stats.CommandesLivrees</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h6 class="text-danger">Annulées</h6>
                        <h3 class="fw-bold">@stats.CommandesAnnulees</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Top produits -->
            <div class="col-lg-6 mb-4">
                <div class="card shadow">
                    <div class="card-header fw-bold text-primary">
                        <i class="bi bi-trophy me-2"></i>Top 5 Produits
                    </div>
                    <div class="card-body">
                        @if (stats.TopProduits.Any())
                        {
                            <table class="table table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produit</th>
                                        <th class="text-end">Quantité</th>
                                        <th class="text-end">CA</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var produit in stats.TopProduits)
                                    {
                                        <tr>
                                            <td>@produit.ProduitNom</td>
                                            <td class="text-end">@produit.QuantiteVendue</td>
                                            <td class="text-end">@produit.ChiffreAffaires.ToString("C", new CultureInfo("fr-FR"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">Aucune vente enregistrée</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Top clients -->
            <div class="col-lg-6 mb-4">
                <div class="card shadow">
                    <div class="card-header fw-bold text-success">
                        <i class="bi bi-star me-2"></i>Top 5 Clients
                    </div>
                    <div class="card-body">
                        @if (stats.TopClients.Any())
                        {
                            <table class="table table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Client</th>
                                        <th class="text-end">Commandes</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var client in stats.TopClients)
                                    {
                                        <tr>
                                            <td>@client.ClientEmail</td>
                                            <td class="text-end">@client.NombreCommandes</td>
                                            <td class="text-end">@client.TotalDepense.ToString("C", new CultureInfo("fr-FR"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">Aucun client</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Commandes récentes -->
        <div class="row">
            <div class="col-12 mb-4">
                <div class="card shadow">
                    <div class="card-header fw-bold text-info">
                        <i class="bi bi-clock-history me-2"></i>Commandes récentes
                    </div>
                    <div class="card-body">
                        @if (stats.CommandesRecentes.Any())
                        {
                            <div style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-sm table-hover">
                                    <thead class="table-light" style="position: sticky; top: 0;">
                                        <tr>
                                            <th>ID</th>
                                            <th>Date</th>
                                            <th>Client</th>
                                            <th>Articles</th>
                                            <th>Statut</th>
                                            <th class="text-end">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cmd in stats.CommandesRecentes)
                                        {
                                            <tr>
                                                <td>#@cmd.Id</td>
                                                <td>@cmd.DateCommande.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@cmd.UtilisateurEmail</td>
                                                <td>@string.Join(", ", cmd.LigneCommandes.Select(l => l.ProduitNom))</td>
                                                <td>
                                                    <span class="badge bg-@GetStatusBadgeClass(cmd.Statut)">
                                                        @GetStatusLabel(cmd.Statut)
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold">@cmd.Total.ToString("C", new CultureInfo("fr-FR"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Aucune commande récente</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .border-start-primary {
        border-left: 0.25rem solid #4e73df !important;
    }

    .border-start-success {
        border-left: 0.25rem solid #1cc88a !important;
    }

    .border-start-info {
        border-left: 0.25rem solid #36b9cc !important;
    }

    .border-start-warning {
        border-left: 0.25rem solid #f6c23e !important;
    }
</style>

@code {
    private AdminDashboardStatsDTO? stats;
    private bool isLoading = true;
    private bool isClient = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            isClient = true;
            isLoading = false;
            return;
        }

        var claims = JwtParser.ParseClaimsFromJwt(token);
        isClient = !claims.Any(c => c.Type.Contains("role") && c.Value == "Admin");

        if (!isClient)
        {
            stats = await dashboardService.GetDashboardStatsAsync();
        }

        isLoading = false;
    }

    private string GetStatusBadgeClass(string statut) => statut switch
    {
        "EnCours" => "warning",
        "Expediée" => "info",
        "Livrée" => "success",
        "Annulée" => "danger",
        _ => "secondary"
    };

    private string GetStatusLabel(string statut) => statut switch
    {
        "EnCours" => "En cours",
        "Expediée" => "Expédiée",
        "Livrée" => "Livrée",
        "Annulée" => "Annulée",
        _ => statut
    };

    public static class JwtParser
    {
        public static IEnumerable<System.Security.Claims.Claim> ParseClaimsFromJwt(string jwt)
        {
            var payload = jwt.Split('.')[1];
            var jsonBytes = ParseBase64WithoutPadding(payload);
            var keyValuePairs = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
            return keyValuePairs.Select(kvp => new System.Security.Claims.Claim(kvp.Key, kvp.Value.ToString()));
        }

        private static byte[] ParseBase64WithoutPadding(string base64)
        {
            switch (base64.Length % 4)
            {
                case 2: base64 += "=="; break;
                case 3: base64 += "="; break;
            }
            return Convert.FromBase64String(base64);
        }
    }
}