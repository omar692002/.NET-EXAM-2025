@page "/"
@attribute [Authorize]

<PageTitle>Accueil</PageTitle>

<div class="container mt-5">
    <h1>Bienvenue dans la Gestion de Parfumerie 🌸</h1>

    <AuthorizeView>
        <Authorized Context="userCtx">
            <div class="alert alert-success mt-4">
                <h4>✅ Vous êtes connecté en tant que : @userCtx.User.Identity?.Name</h4>

                <p class="mb-0">
                    <strong>Vos rôles :</strong>
                    @foreach (var claim in userCtx.User.Claims.Where(c => c.Type.Contains("role")))
                    {
                        <span class="badge bg-primary me-2">@claim.Value</span>
                    }
                </p>
            </div>

            <div class="row mt-4">
                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminCtx">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">🔧 Panel Admin</h5>
                                    <p class="card-text">Gérez les utilisateurs et les produits</p>
                                    <a href="/admin" class="btn btn-primary">Accéder au panel</a>
                                </div>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Client">
                    <Authorized Context="clientCtx">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">🛍️ Produits</h5>
                                    <p class="card-text">Découvrez notre catalogue de parfums</p>
                                    <a href="/products" class="btn btn-success">Voir les produits</a>
                                </div>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
