@page "/admin/familles-olfactives"
@attribute [Authorize(Roles = "Admin")]
@inject FamillesOlfactivesService FamillesService
@inject IJSRuntime JSRuntime
@using Client.Helpers


<h3>Gestion des familles olfactives</h3>

<div class="mb-3 row">
    <div class="col-md-4">
        <input class="form-control" placeholder="Filtrer par nom ou ID" @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary btn-sm" @onclick="ShowCreateModal">
            <i class="bi bi-plus-circle"></i> Ajouter une famille
        </button>
    </div>
</div>

@if (familles == null)
{
    <p>Chargement...</p>
}
else
{
    <div style="max-height: @(FilteredFamilles.Count() > 10 ? "600px" : "auto"); overflow-y: @(FilteredFamilles.Count() > 10 ? "auto" : "visible");">
        <table class="table table-striped">
            <thead style="position: sticky; top: 0; background-color: white; z-index: 10;">
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Nb Produits</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fam in FilteredFamilles)
                {
                    <tr>
                        <td>@fam.Id</td>
                        <td>@fam.Nom</td>
                        <td>@fam.NombreProduits</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" title="Modifier" @onclick="() => ShowEditModal(fam)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-danger btn-sm me-1" title="Supprimer" @onclick="() => Delete(fam.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                            <button class="btn btn-info btn-sm" title="Voir produits" @onclick="() => ShowProducts(fam)">
                                <i class="bi bi-box-seam"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (FilteredFamilles.Count() > 10)
    {
        <div class="alert alert-info mt-2">
            <i class="bi bi-info-circle"></i> @FilteredFamilles.Count() familles olfactives affichées (scroll pour voir plus)
        </div>
    }
}

<!-- Modal Création / Edition -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@modalTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nom</label>
                        <input class="form-control" @bind="modalFamille.Nom" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="SaveFamille">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Produits par famille -->
@if (showProductsModal && selectedFamille != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Produits de @selectedFamille.Nom</h5>
                    <button type="button" class="btn-close" @onclick="CloseProductsModal"></button>
                </div>
                <div class="modal-body">
                    @if (selectedFamille.Produits != null && selectedFamille.Produits.Any())
                    {
                        <div style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-bordered">
                                <thead style="position: sticky; top: 0; background-color: white; z-index: 10;">
                                    <tr>
                                        <th>ID</th>
                                        <th>Nom</th>
                                        <th>Description</th>
                                        <th>Prix</th>
                                        <th>Brand</th>
                                        <th>Familles olfactives</th>
                                        <th>Photo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in selectedFamille.Produits)
                                    {
                                        <tr>
                                            <td>@p.Id</td>
                                            <td>@p.Nom</td>
                                            <td>@p.Description</td>
                                            <td>@p.Prix.ToString("F2") €</td>
                                            <td>@p.BrandNom</td>
                                            <td>@string.Join(", ", p.FamillesOlfactives)</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(p.PhotoPath))
                                                {
                                                    <img src="@ImageHelper.GetImageUrl(p.PhotoPath)"
                                                         alt="@p.Nom"
                                                         style="height:50px; width:50px; object-fit: cover; border-radius: 4px;" />
                                                }
                                                else
                                                {
                                                    <div style="height: 50px; width: 50px; background-color: #e9ecef; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-image" style="font-size: 20px; color: #6c757d;"></i>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> Aucun produit disponible pour cette famille.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseProductsModal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FamilleOlfactiveDTO>? familles;
    private string searchText = "";

    private IEnumerable<FamilleOlfactiveDTO> FilteredFamilles =>
        string.IsNullOrWhiteSpace(searchText)
            ? familles ?? Enumerable.Empty<FamilleOlfactiveDTO>()
            : (familles ?? Enumerable.Empty<FamilleOlfactiveDTO>())
                .Where(f => f.Nom.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                         || f.Id.ToString() == searchText);

    // Modal CRUD
    private bool showModal = false;
    private string modalTitle = "";
    private FamilleOlfactiveDTO modalFamille = new FamilleOlfactiveDTO();
    private FamilleOlfactiveDTO? editingFamille = null;

    // Modal produits
    private FamilleOlfactiveDTO? selectedFamille;
    private bool showProductsModal = false;

    protected override async Task OnInitializedAsync()
    {
        familles = await FamillesService.GetAllAsync();
    }

    private void ShowCreateModal()
    {
        modalFamille = new FamilleOlfactiveDTO();
        editingFamille = null;
        modalTitle = "Nouvelle famille olfactive";
        showModal = true;
    }

    private void ShowEditModal(FamilleOlfactiveDTO fam)
    {
        modalFamille = new FamilleOlfactiveDTO
        {
            Id = fam.Id,
            Nom = fam.Nom,
            NombreProduits = fam.NombreProduits,
            Produits = fam.Produits
        };
        editingFamille = fam;
        modalTitle = "Modifier la famille";
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task SaveFamille()
    {
        if (editingFamille != null)
        {
            await FamillesService.UpdateAsync(editingFamille.Id, modalFamille);
            editingFamille.Nom = modalFamille.Nom;
        }
        else
        {
            modalFamille.NombreProduits = 0;
            var created = await FamillesService.CreateAsync(modalFamille);
            familles?.Add(created);
        }
        showModal = false;
    }

    private async Task Delete(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer cette famille olfactive ?"))
        {
            try
            {
                await FamillesService.DeleteAsync(id);

                familles = await FamillesService.GetAllAsync();

                if (showProductsModal && selectedFamille?.Id == id)
                {
                    CloseProductsModal();
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                // Optionnel : afficher un message d'erreur
                Console.WriteLine($"Erreur lors de la suppression : {ex.Message}");
                await JSRuntime.InvokeVoidAsync("alert", "Erreur lors de la suppression");
            }
        }
    }

    private void ShowProducts(FamilleOlfactiveDTO fam)
    {
        selectedFamille = fam;
        showProductsModal = true;
    }

    private void CloseProductsModal()
    {
        selectedFamille = null;
        showProductsModal = false;
    }
}