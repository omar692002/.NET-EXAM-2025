@page "/admin/commandes"
@attribute [Authorize(Roles = "Admin")]
@inject CommandesService CommandesService

<h3>Gestion des commandes</h3>

@if (commandes == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="table-container" style="@(commandes.Count > 10 ? "max-height: 600px; overflow-y: auto;" : "")">
        <table class="table table-striped">
            <thead style="position: sticky; top: 0; background-color: #fff; z-index: 10;">
                <tr>
                    <th>Commande</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Total</th>
                    <th>Nb Articles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in commandes)
                {
                    <tr>
                        <td>@c.DateCommande.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@c.UtilisateurEmail</td>
                        <td>@c.DateCommande.ToShortDateString()</td>
                        <td>
                            <span class="badge bg-@GetStatutColor(c.Statut)">
                                @FormatStatut(c.Statut)
                            </span>
                        </td>
                        <td>@c.Total.ToString("C")</td>
                        <td>@c.NbArticles</td>
                        <td>
                            <button class="btn btn-sm btn-info me-1" @onclick="() => ShowDetailsModal(c)">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-warning" @onclick="() => ShowStatutModal(c)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <small class="text-muted">Total : @commandes.Count commande(s)</small>
    </div>
}

<!-- Modal détails commande -->
<div class="modal fade @(showDetailsModal ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Détails de la commande</h5>
                <button type="button" class="btn-close" @onclick="CloseDetailsModal"></button>
            </div>
            <div class="modal-body">
                @if (selectedCommande != null)
                {
                    <div class="mb-3">
                        <p><strong>Client :</strong> @selectedCommande.UtilisateurEmail</p>
                        <p><strong>Date :</strong> @selectedCommande.DateCommande.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Statut :</strong> <span class="badge bg-@GetStatutColor(selectedCommande.Statut)">@FormatStatut(selectedCommande.Statut)</span></p>
                    </div>
                }
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Prix Unitaire</th>
                            <th>Quantité</th>
                            <th>Total Ligne</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ligne in selectedCommande?.LigneCommandes ?? Enumerable.Empty<LigneCommandeDTO>())
                        {
                            <tr>
                                <td>@ligne.ProduitNom</td>
                                <td>@ligne.PrixUnitaire.ToString("C")</td>
                                <td>@ligne.Quantite</td>
                                <td>@ligne.TotalLigne.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end"><strong>Total :</strong></td>
                            <td><strong>@selectedCommande?.Total.ToString("C")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDetailsModal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal changement statut -->
<div class="modal fade @(showStatutModal ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Changer le statut</h5>
                <button type="button" class="btn-close" @onclick="CloseStatutModal"></button>
            </div>
            <div class="modal-body">
                @if (selectedCommande != null)
                {
                    <p class="mb-3">
                        <strong>Commande :</strong> @selectedCommande.DateCommande.ToString("dd/MM/yyyy HH:mm")<br />
                        <strong>Client :</strong> @selectedCommande.UtilisateurEmail
                    </p>
                }
                <label class="form-label">Nouveau statut</label>
                <select class="form-select" @bind="newStatut">
                    @foreach (var statut in statutsDisponibles)
                    {
                        <option value="@statut">@FormatStatut(statut)</option>
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseStatutModal">Annuler</button>
                <button class="btn btn-primary" @onclick="SaveStatut">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CommandeDTO>? commandes;
    private List<string> statutsDisponibles = new();

    // Modals
    private bool showDetailsModal = false;
    private bool showStatutModal = false;
    private CommandeDTO? selectedCommande;
    private string newStatut = "EnCours";

    protected override async Task OnInitializedAsync()
    {
        commandes = await CommandesService.GetAllAsync();
        statutsDisponibles = await CommandesService.GetStatutsAsync();

        // Trier les commandes par date décroissante
        if (commandes != null)
        {
            commandes = commandes.OrderByDescending(c => c.DateCommande).ToList();
        }
    }

    private void ShowDetailsModal(CommandeDTO c)
    {
        selectedCommande = c;
        showDetailsModal = true;
    }

    private void CloseDetailsModal() => showDetailsModal = false;

    private void ShowStatutModal(CommandeDTO c)
    {
        selectedCommande = c;
        newStatut = c.Statut.Replace(" ", "");
        showStatutModal = true;
    }

    private void CloseStatutModal() => showStatutModal = false;

    private async Task SaveStatut()
    {
        if (selectedCommande != null)
        {
            await CommandesService.UpdateStatutAsync(selectedCommande.Id, newStatut);
            selectedCommande.Statut = newStatut;
            StateHasChanged();
        }
        showStatutModal = false;
    }

    private string FormatStatut(string statut)
    {
        return statut switch
        {
            "EnCours" => "En cours",
            "Expediée" => "Expédiée",
            "Livrée" => "Livrée",
            "Annulée" => "Annulée",
            _ => statut
        };
    }

    private string GetStatutColor(string statut)
    {
        return statut switch
        {
            "EnCours" => "warning",
            "Expediée" => "info",
            "Livrée" => "success",
            "Annulée" => "danger",
            _ => "secondary"
        };
    }
}